{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/system-message",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reminder",
      "schedule": "0 1 * * *"
    }
  ]
}
